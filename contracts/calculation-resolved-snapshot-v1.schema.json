{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospektprint.ru/contracts/prospektweb-calc/calculation-resolved-snapshot-v1.schema.json",
  "title": "Resolved immutable calculation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshotId",
    "presetId",
    "presetRevision",
    "instanceId",
    "familyId",
    "version",
    "contentHash",
    "dependencyLock",
    "resolvedGraph",
    "provenance",
    "snapshotHash",
    "createdAt"
  ],
  "properties": {
    "schema": {"const": "prospektweb.calc.resolved-snapshot/v1"},
    "snapshotId": {"type": "string", "minLength": 1},
    "presetId": {"$ref": "#/$defs/localId"},
    "presetRevision": {"type": "integer", "minimum": 1},
    "instanceId": {"type": "string", "minLength": 1},
    "familyId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "contentHash": {"$ref": "#/$defs/hash"},
    "dependencyLock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "familyId", "version", "contentHash"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "familyId": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "contentHash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "resolvedGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootNodeId", "nodes", "executionOrder"],
      "properties": {
        "rootNodeId": {"type": "string", "minLength": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "executionOrder": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "materialization": {
      "type": "object",
      "description": "Exact resolved legacy payload written or evaluated for this snapshot."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvedBy", "resolverVersion", "instanceRevision"],
      "properties": {
        "resolvedBy": {"type": "string", "minLength": 1},
        "resolverVersion": {"type": "string", "minLength": 1},
        "instanceRevision": {"type": "integer", "minimum": 1},
        "legacySnapshotHash": {"$ref": "#/$defs/hash"}
      }
    },
    "snapshotHash": {"$ref": "#/$defs/hash"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "localId": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^[1-9][0-9]*$"}
      ]
    }
  }
}
