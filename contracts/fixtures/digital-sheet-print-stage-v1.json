{
  "schema": "prospektweb.calc.module/v1",
  "familyId": "digital_sheet_print",
  "version": "1.0.0",
  "kind": "stage",
  "status": "published",
  "name": "Цифровая печать листов",
  "description": "Универсальный расчёт раскладки, листов и стоимости цифровой печати без продуктовых ID.",
  "content": {
    "rootNodeId": "digitalPrint",
    "nodes": [
      {
        "nodeId": "digitalPrint",
        "nodeType": "stage",
        "order": 0,
        "name": "Цифровая печать листов",
        "logic": {
          "version": 1,
          "vars": [
            {"name": "usableWidthMm", "formula": "max(sheetWidthMm - fieldsWidthMm, 0)"},
            {"name": "usableLengthMm", "formula": "max(sheetLengthMm - fieldsLengthMm, 0)"},
            {"name": "itemWithBleedWidthMm", "formula": "itemWidthMm + bleedMm * 2"},
            {"name": "itemWithBleedLengthMm", "formula": "itemLengthMm + bleedMm * 2"},
            {"name": "itemsPerSheetDirect", "formula": "floor(usableWidthMm / itemWithBleedWidthMm) * floor(usableLengthMm / itemWithBleedLengthMm)"},
            {"name": "itemsPerSheetRotated", "formula": "floor(usableWidthMm / itemWithBleedLengthMm) * floor(usableLengthMm / itemWithBleedWidthMm)"},
            {"name": "itemsPerSheet", "formula": "max(itemsPerSheetDirect, itemsPerSheetRotated)"},
            {"name": "printSheetsQty", "formula": "if(itemsPerSheet > 0, ceil(quantity / itemsPerSheet), 0)"},
            {"name": "impressionsQty", "formula": "printSheetsQty * if(twoSided, 2, 1)"},
            {"name": "operationPurchasingCost", "formula": "setupCost + impressionsQty * impressionPurchasingPrice"},
            {"name": "operationBaseCost", "formula": "setupCost + impressionsQty * impressionBasePrice"}
          ]
        }
      }
    ]
  },
  "ports": [
    {"code": "quantity", "direction": "input", "valueType": "number", "required": true, "unit": "piece"},
    {"code": "itemWidthMm", "direction": "input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "itemLengthMm", "direction": "input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "bleedMm", "direction": "input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "twoSided", "direction": "input", "valueType": "boolean", "required": true},
    {"code": "sheetWidthMm", "direction": "global-input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "sheetLengthMm", "direction": "global-input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "fieldsWidthMm", "direction": "global-input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "fieldsLengthMm", "direction": "global-input", "valueType": "number", "required": true, "unit": "mm"},
    {"code": "setupCost", "direction": "global-input", "valueType": "number", "required": true, "unit": "rub"},
    {"code": "impressionPurchasingPrice", "direction": "global-input", "valueType": "number", "required": true, "unit": "rub"},
    {"code": "impressionBasePrice", "direction": "global-input", "valueType": "number", "required": true, "unit": "rub"},
    {"code": "itemsPerSheet", "direction": "output", "valueType": "number", "required": true, "unit": "piece"},
    {"code": "printSheetsQty", "direction": "output", "valueType": "number", "required": true, "unit": "sheet"},
    {"code": "impressionsQty", "direction": "output", "valueType": "number", "required": true, "unit": "impression"},
    {"code": "operationPurchasingCost", "direction": "output", "valueType": "number", "required": true, "unit": "rub"},
    {"code": "operationBaseCost", "direction": "output", "valueType": "number", "required": true, "unit": "rub"}
  ],
  "entityRoles": [
    {"code": "printOperation", "entityType": "operation", "cardinality": "one", "description": "Операция цифровой печати выбирается в экземпляре."},
    {"code": "paper", "entityType": "material", "cardinality": "one", "description": "Материал выбирается в экземпляре."}
  ],
  "dependencies": [],
