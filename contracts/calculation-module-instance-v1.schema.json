{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospektprint.ru/contracts/prospektweb-calc/calculation-module-instance-v1.schema.json",
  "title": "Calculation module instance binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "instanceId",
    "presetId",
    "familyId",
    "version",
    "contentHash",
    "revision",
    "bindings",
    "entityBindings",
    "dependencyLock",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "prospektweb.calc.module-instance/v1"},
    "instanceId": {"$ref": "#/$defs/id"},
    "presetId": {"$ref": "#/$defs/localId"},
    "familyId": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "contentHash": {"$ref": "#/$defs/hash"},
    "revision": {"type": "integer", "minimum": 1},
    "enabled": {"type": "boolean", "default": true},
    "order": {"type": "integer", "minimum": 0},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["portCode", "target"],
        "properties": {
          "portCode": {"$ref": "#/$defs/id"},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"enum": ["source-path", "global", "literal", "module-port"]},
              "value": {}
            }
          }
        }
      }
    },
    "entityBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleCode", "entityType", "localElementIds"],
        "properties": {
          "roleCode": {"$ref": "#/$defs/id"},
          "entityType": {"type": "string", "minLength": 1},
          "localElementIds": {
            "type": "array",
            "items": {"$ref": "#/$defs/localId"}
          },
          "options": {"type": "object"}
        }
      }
    },
    "activationCondition": {"type": ["object", "null"]},
    "globalAssignments": {"type": "array", "items": {"type": "object"}},
    "customFieldValues": {"type": "object"},
    "dependencyLock": {
      "type": "array",
      "items": {"$ref": "#/$defs/lock"}
    },
    "snapshotId": {"$ref": "#/$defs/id"},
    "snapshotHash": {"$ref": "#/$defs/hash"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "createdBy", "legacyElementIds"],
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": "string", "minLength": 1},
        "legacyElementIds": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"$ref": "#/$defs/localId"},
              {
                "type": "array",
                "items": {"$ref": "#/$defs/localId"}
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "localId": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^[1-9][0-9]*$"}
      ]
    },
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "familyId", "version", "contentHash"],
      "properties": {
        "ref": {"$ref": "#/$defs/id"},
        "familyId": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
